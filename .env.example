# Copy to .env and replace 192.168.1.50 with this computer's LAN IP address.
# HTTPS is required when the phone page uses getUserMedia outside localhost.
HOST=0.0.0.0
PORT=8443
PHONE_BASE_URL=https://192.168.1.50:8443
TLS_CERT_FILE=./certs/camera-local.pem
TLS_KEY_FILE=./certs/camera-local-key.pem

# Plain HTTP/WS bridge for TouchDesigner on this same machine. The server
# rejects any non-loopback host for this listener.
LOCAL_HTTP_ENABLED=true
LOCAL_HTTP_HOST=127.0.0.1
LOCAL_HTTP_PORT=8080

# Optional authentication for the separate commenter station. When set, the
# commenter must send this same value as RELAY_SHARED_TOKEN in its version-1
# internetcafe.comments hello on /comments/relay.
RELAY_SHARED_TOKEN=

# Ignore phone filter-step requests that arrive sooner than this for one seat.
FILTER_STEP_INTERVAL_MS=150

# Rebuild a freshly connected phone's ephemeral feed from recent accepted
# comments. Nothing is written to disk or replayed after this age.
COMMENT_REPLAY_LIMIT=6
COMMENT_REPLAY_MAX_AGE_MS=120000
